{
  "experiment_name": "edge_detector_experiment",
  "freeze_layer1": false,
  "images_dir": "./dataset_shrunk_masks/images/",
  "masks_dir": "./dataset_shrunk_masks/masks/",
  "train_val_split": 0.8,
  "output_dir_base": "./edge_detector_experiment",
  "img_size": 512,
  "img_channels": 1,
  "n_filters": 32,
  "dropout": 0.2,
  "learning_rate": 0.001,
  "epochs": 100,
  "batch_size": 4,
  "early_stopping_patience": 20,
  "reduce_lr_patience": 10,
  "reduce_lr_factor": 0.5,
  "min_lr": 1e-07,
  "focal_gamma": 2.0,
  "focal_alpha": 0.25,
  "random_seed": 42,
  "save_layer1_weights_every": 10,
  "variant": "trainable_layer1"
}